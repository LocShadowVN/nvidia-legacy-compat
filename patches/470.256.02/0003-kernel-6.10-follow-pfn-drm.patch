--- a/kernel/nvidia/os-mlock.c
+++ b/kernel/nvidia/os-mlock.c
@@ -1,6 +1,25 @@
 static inline int nv_follow_pfn(struct vm_area_struct *vma,
                                 unsigned long address,
                                 unsigned long *pfn)
 {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0)
+    struct follow_pfnmap_args args = { .vma = vma, .address = address };
+    int ret = follow_pfnmap_start(&args);
+    if (ret)
+        return ret;
+    *pfn = args.pfn;
+    follow_pfnmap_end(&args);
+    return 0;
+#elif LINUX_VERSION_CODE >= KERNEL_VERSION(6, 10, 0)
+    pte_t *ptep = NULL;
+    spinlock_t *ptl = NULL;
+    int ret = follow_pte(vma, address, &ptep, &ptl);
+    if (ret)
+        return ret;
+    *pfn = pte_pfn(ptep_get(ptep));
+    pte_unmap_unlock(ptep, ptl);
+    return 0;
+#else
     return follow_pfn(vma, address, pfn);
+#endif
 }
